[Unit]
Description=Lixun Search Daemon
# Wait for the XDG desktop portal to be up before we try to register an
# application identity and bind global shortcuts. Without this ordering,
# lixund races the portal's DBus activation during login and can hit
# `org.freedesktop.DBus.Error.UnknownMethod: No such interface
# "org.freedesktop.portal.GlobalShortcuts"` because the KDE backend has not
# yet exported the interface on `org.freedesktop.portal.Desktop`.
After=graphical-session.target xdg-desktop-portal.service
Wants=xdg-desktop-portal.service
PartOf=graphical-session.target

[Service]
ExecStart=/usr/bin/lixund
Restart=on-failure
RestartSec=2s
# Pin the fastembed model cache under the user's cache home. Without this,
# fastembed downloads ONNX text/image models into its built-in default
# ($XDG_CACHE_HOME/.fastembed_cache/), which is opaque to operators; pinning
# keeps the cache discoverable and matches the path documented in
# docs/wave-d-semantic.md. %h expands to $HOME at unit start.
Environment=FASTEMBED_CACHE_DIR=%h/.cache/lixun/fastembed

[Install]
# MUST be graphical-session.target, not default.target. `After=` above only
# orders units within one transaction, and default.target does not pull in
# graphical-session.target — so hanging off default.target makes that ordering
# inert and lixund races the session up. Measured on a Plasma 6 Wayland login:
# lixund active at 15:07:14, graphical-session.target at 15:07:18, i.e. lixund
# won by 4s and froze a pre-session environment (no XAUTHORITY, no
# XDG_CURRENT_DESKTOP) for the lifetime of the process.
#
# That env is inherited by lixun-gui and in turn by every process it launches
# for a search hit, so the symptom is remote from the cause: hits stop opening
# (X11 clients get DISPLAY with no cookie) or open in the wrong application
# (without XDG_CURRENT_DESKTOP, xdg-open skips the desktop-specific
# kde-mimeapps.list and falls through to the first mimeinfo.cache entry).
#
# graphical-session.target is the conventional anchor for session-scoped user
# services — kde-baloo.service, waybar.service et al. all hang off it — and
# pairs with the PartOf= above so lixund also stops when the session ends.
WantedBy=graphical-session.target
