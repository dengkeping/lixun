#!/usr/bin/make -f

%:
	dh $@ --buildsystem=none

override_dh_auto_build:
	cargo build --release --locked -p lixun-daemon -p lixun-cli -p lixun-gui -p lixun-preview-bin -p lixun-semantic-worker

override_dh_strip:
	dh_strip --no-automatic-dbgsym

override_dh_installsystemduser:
	dh_installsystemduser --no-enable
