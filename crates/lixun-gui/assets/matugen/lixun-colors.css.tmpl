/*
 * lixun matugen template.
 *
 * Rendered by matugen to ~/.config/lixun/colors.css (default path)
 * or whatever path is configured as `matugen_colors_path` under
 * `[gui]` in lixun's config.toml. Loaded by lixun-gui as a
 * GtkCssProvider at GTK_STYLE_PROVIDER_PRIORITY_APPLICATION + 3 --
 * the top of the cascade, sitting above the embedded fallback
 * stylesheet (priority +0), user override file (priority +1), and
 * named theme (priority +2). Matugen wins for any selector that
 * resolves `--lixun-*` via var().
 *
 * Do NOT edit this file by hand -- matugen overwrites it on every
 * palette regeneration. To override individual tokens, edit
 * ~/.config/lixun/style.css instead (loaded at priority +1) or write
 * a named theme under ~/.config/lixun/themes/<name>/style.css
 * (priority +2).
 *
 * Token namespace: every name is prefixed `--lixun-` so we never
 * collide with GTK4 / libadwaita system tokens (--accent-color,
 * --window-bg-color, ...).
 *
 * Mechanism: CSS Custom Properties + var(). GTK4 ≥ 4.16 supports
 * the standard cascade for custom properties, which means a value
 * declared in this provider is visible to selectors in every other
 * provider on the same display. This is REQUIRED -- the older
 * @define-color mechanism is provider-local, so a matugen palette
 * defined via @define-color here would never reach the @lixun_*
 * references in the embedded stylesheet. See
 * https://docs.gtk.org/gtk4/css-properties.html#custom-properties.
 *
 * Declarations are scoped to `window, popover` so both the main
 * layer-shell surface and any popovers (context menu, etc.) inherit
 * the palette through the GTK widget tree.
 */

window, popover {
    --lixun-primary:                       {{colors.primary.default.hex}};
    --lixun-on-primary:                    {{colors.on_primary.default.hex}};
    --lixun-primary-container:             {{colors.primary_container.default.hex}};
    --lixun-on-primary-container:          {{colors.on_primary_container.default.hex}};
    --lixun-primary-fixed:                 {{colors.primary_fixed.default.hex}};
    --lixun-primary-fixed-dim:             {{colors.primary_fixed_dim.default.hex}};
    --lixun-on-primary-fixed:              {{colors.on_primary_fixed.default.hex}};
    --lixun-on-primary-fixed-variant:      {{colors.on_primary_fixed_variant.default.hex}};

    --lixun-secondary:                     {{colors.secondary.default.hex}};
    --lixun-on-secondary:                  {{colors.on_secondary.default.hex}};
    --lixun-secondary-container:           {{colors.secondary_container.default.hex}};
    --lixun-on-secondary-container:        {{colors.on_secondary_container.default.hex}};
    --lixun-secondary-fixed:               {{colors.secondary_fixed.default.hex}};
    --lixun-secondary-fixed-dim:           {{colors.secondary_fixed_dim.default.hex}};
    --lixun-on-secondary-fixed:            {{colors.on_secondary_fixed.default.hex}};
    --lixun-on-secondary-fixed-variant:    {{colors.on_secondary_fixed_variant.default.hex}};

    --lixun-tertiary:                      {{colors.tertiary.default.hex}};
    --lixun-on-tertiary:                   {{colors.on_tertiary.default.hex}};
    --lixun-tertiary-container:            {{colors.tertiary_container.default.hex}};
    --lixun-on-tertiary-container:         {{colors.on_tertiary_container.default.hex}};
    --lixun-tertiary-fixed:                {{colors.tertiary_fixed.default.hex}};
    --lixun-tertiary-fixed-dim:            {{colors.tertiary_fixed_dim.default.hex}};
    --lixun-on-tertiary-fixed:             {{colors.on_tertiary_fixed.default.hex}};
    --lixun-on-tertiary-fixed-variant:     {{colors.on_tertiary_fixed_variant.default.hex}};

    --lixun-surface:                       {{colors.surface.default.hex}};
    --lixun-on-surface:                    {{colors.on_surface.default.hex}};
    --lixun-surface-variant:               {{colors.surface_variant.default.hex}};
    --lixun-on-surface-variant:            {{colors.on_surface_variant.default.hex}};
    --lixun-surface-dim:                   {{colors.surface_dim.default.hex}};
    --lixun-surface-bright:                {{colors.surface_bright.default.hex}};
    --lixun-surface-container-lowest:      {{colors.surface_container_lowest.default.hex}};
    --lixun-surface-container-low:         {{colors.surface_container_low.default.hex}};
    --lixun-surface-container:             {{colors.surface_container.default.hex}};
    --lixun-surface-container-high:        {{colors.surface_container_high.default.hex}};
    --lixun-surface-container-highest:     {{colors.surface_container_highest.default.hex}};

    --lixun-background:                    {{colors.background.default.hex}};
    --lixun-on-background:                 {{colors.on_background.default.hex}};

    --lixun-error:                         {{colors.error.default.hex}};
    --lixun-on-error:                      {{colors.on_error.default.hex}};
    --lixun-error-container:               {{colors.error_container.default.hex}};
    --lixun-on-error-container:            {{colors.on_error_container.default.hex}};

    --lixun-outline:                       {{colors.outline.default.hex}};
    --lixun-outline-variant:               {{colors.outline_variant.default.hex}};

    --lixun-shadow:                        {{colors.shadow.default.hex}};
    --lixun-scrim:                         {{colors.scrim.default.hex}};

    --lixun-inverse-surface:               {{colors.inverse_surface.default.hex}};
    --lixun-inverse-on-surface:            {{colors.inverse_on_surface.default.hex}};
    --lixun-inverse-primary:               {{colors.inverse_primary.default.hex}};
}
